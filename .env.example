# Copier vers .env et remplir. Ne JAMAIS committer .env.

# --- API gRPC (apps/api) ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=50051
LOG_LEVEL=info

# --- Web (apps/web) ---
# Adresse du backend gRPC vue depuis le serveur Next.js (jamais exposée au navigateur)
GRPC_API_URL=localhost:50051
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Valeurs par défaut suffisantes en développement. Next.js ne lit PAS ce .env racine pour le site :
# pour surcharger, créer apps/web/.env.local.
# Délai maximum d'un appel gRPC depuis le site (ms)
# GRPC_TIMEOUT_MS=5000
# Nombre de proxys de confiance devant Next.js (0 = aucun, valeur de dev). Derrière un reverse proxy (Phase 12) : 1.
# Sert à transmettre la vraie IP du visiteur à l'API pour la limitation de débit. Ne jamais mettre 1 sans proxy.
# TRUSTED_PROXY_HOPS=0
# Cookies "Secure" : actif par défaut si NEXT_PUBLIC_SITE_URL commence par https://
# COOKIE_SECURE=true

# --- Base de données PostgreSQL (docker-compose.dev.yml) ---
# Identifiants de DEV LOCAL uniquement. Doivent rester cohérents avec DATABASE_URL.
POSTGRES_USER=center
POSTGRES_PASSWORD=center_dev_only
POSTGRES_DB=center
POSTGRES_PORT=15433
DATABASE_URL=postgresql://center:center_dev_only@127.0.0.1:15433/center

# --- Authentification (Phase 5) ---
# Secret de signature des jetons d'accès : OBLIGATOIRE, aléatoire, >= 32 caractères, unique par environnement.
# Générer une valeur : node -p "require('crypto').randomBytes(48).toString('base64url')"
# L'API refuse de démarrer si cette variable est vide ou trop courte. Ne jamais la committer.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# URL publique du site (liens envoyés par e-mail)
SITE_URL=http://localhost:3000
# console = affiche les liens dans les logs (DÉVELOPPEMENT uniquement, interdit en production)
# none    = n'envoie rien (défaut en production tant que le SMTP n'est pas configuré, Phase 12)
# EMAIL_PROVIDER=console
